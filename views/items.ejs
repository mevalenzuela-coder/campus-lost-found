
<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Item Reports | Campus Lost and Found</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f5f9;
            padding: 25px;
        }
        .container {
            max-width: 950px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
        }
        .item {
            border: 1px solid #ddd;
            padding: 15px;
            margin: 15px 0;
            border-radius: 8px;
        }
        h1, h2 { color: #234b76; }
        a { color: #234b76; }
        input, select, button {
            padding: 10px;
            margin: 5px 3px 5px 0;
        }
        button {
            background: #234b76;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .filters { margin: 20px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Lost and Found Item Reports</h1>

        <p>Logged in as: <strong><%= user.name %></strong></p>

        <p>
            <a href="/report">+ Report an Item</a> |
            <a href="/dashboard">Dashboard</a>
        </p>

        <form action="/items" method="GET" class="filters">
            <label for="q">Search items:</label><br>
            <input
                type="text"
                id="q"
                name="q"
                placeholder="Name, description, category, location"
                value="<%= search || '' %>"
            >

            <select name="type">
                <option value="">All Types</option>
                <option value="Lost" <%= selectedType === 'Lost' ? 'selected' : '' %>>Lost</option>
                <option value="Found" <%= selectedType === 'Found' ? 'selected' : '' %>>Found</option>
            </select>

            <select name="status">
                <option value="">All Statuses</option>
                <option value="Pending" <%= selectedStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option value="Approved" <%= selectedStatus === 'Approved' ? 'selected' : '' %>>Approved</option>
                <option value="Claimed" <%= selectedStatus === 'Claimed' ? 'selected' : '' %>>Claimed</option>
                <option value="Returned" <%= selectedStatus === 'Returned' ? 'selected' : '' %>>Returned</option>
            </select>

            <button type="submit">Search / Filter</button>
            <a href="/items">Clear</a>
        </form>

        <% if (items.length === 0) { %>
            <p>No matching item reports found.</p>
        <% } %>

        <% items.forEach(item => { %>
            <div class="item">
                <h2><%= item.item_name %></h2>
                <p><strong>Type:</strong> <%= item.report_type %></p>
                <p><strong>Description:</strong> <%= item.description %></p>
                <p><strong>Category:</strong> <%= item.category %></p>
                <p><strong>Location:</strong> <%= item.location %></p>
                <p><strong>Date:</strong>
                    <%= String(item.date_lost_or_found).slice(0, 10) %>
                </p>
                <p><strong>Status:</strong> <%= item.status %></p>
                <p><strong>Reported by:</strong> <%= item.reporter_name %></p>
                
<% if (Number(user.id) === Number(item.user_id) && item.status === 'Pending') { %>
    <a href="/items/<%= item.id %>/edit" class="edit-button">
        Edit Item
    </a>

    <form action="/items/<%= item.id %>/delete" method="POST"
          onsubmit="return confirm('Are you sure you want to delete this report?');">
        <button type="submit" class="delete-button">
            Delete Item
        </button>
    </form>
<% } %>

            </div>
        <% }) %>
    </div>
</body>
</html>

